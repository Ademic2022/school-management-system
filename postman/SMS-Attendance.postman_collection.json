{
  "info": {
    "_postman_id": "35146c2f-63f2-41ff-b8b6-23da846cb7e6",
    "name": "SMS Attendance API",
    "description": "Checks the attendance endpoints: bulk marking, re-marking (update, not duplicate), validation, role permissions and filtering.\n\nPrerequisites: `python manage.py migrate && python manage.py seed`, server on {{baseUrl}}.\n\nRun the whole collection in order (Collection Runner); later requests use tokens and ids saved by earlier ones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Default the attendance date to today in local time (not toISOString, which is UTC)",
          "if (!pm.collectionVariables.get('attendanceDate')) {",
          "  pm.collectionVariables.set('attendanceDate', new Date().toLocaleDateString('en-CA'));",
          "}"
        ]
      }
    }
  ],
