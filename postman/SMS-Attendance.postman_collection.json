                  "const records = ids.map((id, i) => ({ student: id, status: i === 0 ? 'PRESENT' : 'PRESENT' }));",
                  "pm.variables.set('markBody', JSON.stringify({",
                  "  classroom: Number(pm.collectionVariables.get('classroomId')),",
                  "  date: pm.collectionVariables.get('attendanceDate'),",
                  "  records,",
                  "}));",
                  "const body = JSON.parse(pm.variables.get('markBody'));",
