                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "login",
                ""
              ]
            },
            "description": "Logs in as the seeded teacher and stores the token in {{teacherToken}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{teacherEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
