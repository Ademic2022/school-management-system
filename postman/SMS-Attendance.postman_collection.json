    {
      "name": "6. Records",
      "item": [
        {
          "name": "Filter records by classroom and date (teacher)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{teacherToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/core/attendance/?classroom={{classroomId}}&date={{attendanceDate}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "core",
                "attendance",
                ""
              ],
              "query": [
                {
                  "key": "classroom",
                  "value": "{{classroomId}}"
                },
                {
                  "key": "date",
                  "value": "{{attendanceDate}}"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json();",
                  "const classroomId = Number(pm.collectionVariables.get('classroomId'));",
                  "const date = pm.collectionVariables.get('attendanceDate');",
                  "const ids = JSON.parse(pm.collectionVariables.get('studentIds'));",
                  "pm.test('one row per student', () => pm.expect(rows.length).to.eql(ids.length));",
                  "pm.test('rows match the filter', () => rows.forEach(r => {",
                  "  pm.expect(r.classroom).to.eql(classroomId);",
                  "  pm.expect(r.date).to.eql(date);",
                  "}));",
                  "pm.test('re-marked status persisted', () => {",
                  "  pm.expect(rows.find(r => r.student === ids[0]).status).to.eql('LATE');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter records (admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{adminToken}}"
