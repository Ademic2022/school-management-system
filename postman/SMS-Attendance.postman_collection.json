    {
      "name": "2. Setup",
      "item": [
        {
          "name": "List classrooms (teacher)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{teacherToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/core/classrooms/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "core",
                "classrooms",
                ""
              ]
            },
            "description": "Stores the first classroom's id in {{classroomId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const rooms = pm.response.json();",
                  "pm.test('has classrooms (run `manage.py seed` first)', () => pm.expect(rooms.length).to.be.above(0));",
                  "pm.collectionVariables.set('classroomId', rooms[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List students in classroom",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{teacherToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/core/students/?classroom={{classroomId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "core",
                "students",
                ""
              ],
              "query": [
                {
                  "key": "classroom",
                  "value": "{{classroomId}}"
                }
              ]
            },
            "description": "Loads the class roster and stores the ids in {{studentIds}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const students = pm.response.json();",
                  "const classroomId = Number(pm.collectionVariables.get('classroomId'));",
                  "pm.test('only students from this classroom', () => {",
                  "  pm.expect(students.length).to.be.above(0);",
                  "  students.forEach(s => pm.expect(s.classroom.id).to.eql(classroomId));",
                  "});",
                  "pm.collectionVariables.set('studentIds', JSON.stringify(students.map(s => s.id)));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Bulk mark",
      "item": [
        {
          "name": "Mark class (all PRESENT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{teacherToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/core/attendance/bulk_mark/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "core",
                "attendance",
                "bulk_mark",
                ""
              ]
            },
            "description": "Marks every student PRESENT for {{attendanceDate}}. On a fresh database `created` equals the class size; if you rerun the collection they show as `updated`.",
            "body": {
              "mode": "raw",
              "raw": "{{markBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Build one record per student; the first student gets the status under test",
                  "const ids = JSON.parse(pm.collectionVariables.get('studentIds'));",
                  "const records = ids.map((id, i) => ({ student: id, status: i === 0 ? 'PRESENT' : 'PRESENT' }));",
                  "pm.variables.set('markBody', JSON.stringify({",
                  "  classroom: Number(pm.collectionVariables.get('classroomId')),",
                  "  date: pm.collectionVariables.get('attendanceDate'),",
                  "  records,",
                  "}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const count = JSON.parse(pm.collectionVariables.get('studentIds')).length;",
                  "pm.test('one record per student', () => pm.expect(body.records.length).to.eql(count));",
                  "pm.test('created + updated covers the class', () => pm.expect(body.created + body.updated).to.eql(count));",
                  "pm.test('all PRESENT', () => body.records.forEach(r => pm.expect(r.status).to.eql('PRESENT')));",
                  "pm.collectionVariables.set('firstRecordIds', JSON.stringify(body.records.map(r => r.id).sort()));"
                ]
              }
            }
          ]
        },
        {
          "name": "Re-mark same day (first student LATE)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{teacherToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/core/attendance/bulk_mark/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "core",
                "attendance",
                "bulk_mark",
                ""
              ]
            },
            "description": "Same classroom and date with one status changed. Proves update_or_create updates in place: created=0 and the record ids are unchanged.",
            "body": {
              "mode": "raw",
              "raw": "{{markBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Build one record per student; the first student gets the status under test",
                  "const ids = JSON.parse(pm.collectionVariables.get('studentIds'));",
                  "const records = ids.map((id, i) => ({ student: id, status: i === 0 ? 'LATE' : 'PRESENT' }));",
                  "pm.variables.set('markBody', JSON.stringify({",
                  "  classroom: Number(pm.collectionVariables.get('classroomId')),",
                  "  date: pm.collectionVariables.get('attendanceDate'),",
                  "  records,",
                  "}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const count = JSON.parse(pm.collectionVariables.get('studentIds')).length;",
                  "pm.test('nothing created', () => pm.expect(body.created).to.eql(0));",
                  "pm.test('every record updated', () => pm.expect(body.updated).to.eql(count));",
                  "pm.test('same record ids as the first mark (no duplicates)', () => {",
                  "  const ids = JSON.stringify(body.records.map(r => r.id).sort());",
                  "  pm.expect(ids).to.eql(pm.collectionVariables.get('firstRecordIds'));",
                  "});",
                  "const firstStudent = JSON.parse(pm.collectionVariables.get('studentIds'))[0];",
                  "pm.test('changed status saved', () => {",
                  "  pm.expect(body.records.find(r => r.student === firstStudent).status).to.eql('LATE');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
